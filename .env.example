# Server configuration. Either set these as environment variables or copy this file
# to .env: `pnpm dev` and `pnpm start` load .env, and variables already set in the
# environment take precedence over it.

# api | worker | all
MODE=all
PORT=3000
BASE_URL=http://localhost:3000

# PostgreSQL. Row-level security keeps tenants apart on every query in both setups.
#
# Simple: one URL, whose user owns the tables. The server creates the fw_app and fw_system roles
# (no login) and runs migrations as it starts, and its connections switch to those roles as they
# log in. It needs a user that can create roles (the official image's user and most managed
# Postgres default users can), and a direct connection or a pooler that passes startup options.
DATABASE_URL=postgres://flagwise:change-me@localhost:5432/flagwise
#
# Strict: the server logs in as each role and never holds the owner's password, so even a
# compromised server cannot read past row-level security or change the schema. Set the app and
# system URLs together; they win over DATABASE_URL. The owner and admin URLs belong only where the
# CLI runs: `pnpm flagwise db:init` (once, as DATABASE_ADMIN_URL, creating the roles named in the
# URLs with their passwords) and `db:migrate` (each release, needs only the owner URL). The server
# can be deployed before db:migrate runs: /readyz answers 503 until the migrations are applied.
# DATABASE_ADMIN_URL=postgres://postgres:change-me@localhost:5432/postgres
# DATABASE_OWNER_URL=postgres://fw_owner:change-me-owner@localhost:5432/flagwise
# DATABASE_APP_URL=postgres://fw_app:change-me-app@localhost:5432/flagwise
# DATABASE_SYSTEM_URL=postgres://fw_system:change-me-system@localhost:5432/flagwise
# Connections per role (default 10).
DATABASE_POOL_MAX=

# Outgoing mail (notices, invitations, alerts).
SMTP_URL=smtp://localhost:1025

# local (files under STORAGE_DIR, default .data/storage; a relative path is from where you run the
# command) or s3 (any S3-compatible store)
STORAGE_DRIVER=local
STORAGE_DIR=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional, default us-east-1.
S3_REGION=

# Each app's token bucket for the public API (defaults 10 per second, burst 50).
API_RATE_PER_SECOND=
API_RATE_BURST=

# The install's LLM, used by every app (an app can turn it off). Empty: every case is
# classified by rules only.
# anthropic, openai-compatible (OpenAI, Ollama, vLLM, OpenRouter, Groq and the like), gemini, or
# fake (no network or key: answers from the report's text, the same every time; for local
# development and tests; tags such as [fake:fail] in the text steer it).
LLM_PROVIDER=
# Required for anthropic and gemini; optional for openai-compatible (a local Ollama needs none);
# unused by fake.
LLM_API_KEY=
# anthropic, gemini: optional, for a proxy or gateway. openai-compatible: required, such as
# http://localhost:11434/v1 for Ollama or https://api.openai.com/v1.
LLM_BASE_URL=
# anthropic defaults: claude-haiku-5-5 for every case, claude-sonnet-5-5 for escalation; fake:
# fake-small and fake-strong.
# openai-compatible, gemini: LLM_MODEL is required; escalation uses LLM_MODEL unless set.
LLM_MODEL=
LLM_ESCALATION_MODEL=
# openai-compatible only: schema (default) asks for the answer's JSON schema; object asks only
# for a JSON object, for servers or models without JSON-schema output.
LLM_JSON_MODE=
# Optional guidance for the classifier, tuned to your model. Default: the guidance shipped in
# packages/modules/classify/prompts/default.md. Files in prompts/ are not committed.
LLM_PROMPT_FILE=
# Replace PII with typed tokens before evidence is sent to the LLM. true or false.
LLM_REDACTION=true

# Master keys for secrets stored at rest (webhook signing secrets), as id:base64key entries
# separated by commas, the current one first. Make one with `pnpm flagwise secrets:new-key`.
# Instead of the keys, the path of a file holding them (a mounted secret, or a file a vault agent
# writes), such as the-secret-key or /run/secrets/flagwise; a relative path is from where you run
# the command. Unset: webhooks are off. To rotate: put a new entry first, keep the old one after
# it, restart, run `pnpm flagwise secrets:rewrap`, then drop the old entry.
SECRETS_ENCRYPTION_KEY=
# true allows http: webhook endpoints, for local development only. Default false (https only).
WEBHOOKS_ALLOW_HTTP=
